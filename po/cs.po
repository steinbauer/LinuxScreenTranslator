msgid "target language, e.g. CS"
msgstr "cílový jazyk, například CS"

#: linux_screen_translator/cli.py:17
msgid "keep the original text instead of erasing it"
msgstr "nevymazávat původní text, jen přes něj psát"

#: linux_screen_translator/cli.py:50
msgid "→ (left unchanged)"
msgstr "→ (ponecháno beze změny)"

#: linux_screen_translator/cli.py:33
msgid "Selection cancelled."
msgstr "Výběr zrušen."

#: linux_screen_translator/cli.py:47
msgid "Done — {summary}, written to {path}"
msgstr "Hotovo — {summary}, uloženo do {path}"

