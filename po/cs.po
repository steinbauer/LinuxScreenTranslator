#: linux_screen_translator/app.py:440
#: linux_screen_translator/translate.py:192
msgid "Enter a key to see the remaining quota."
msgstr "Zadej klíč a uvidíš zbývající limit."

#: linux_screen_translator/app.py:130
#: linux_screen_translator/pipeline.py:35
msgid "No text was found in the selected area."
