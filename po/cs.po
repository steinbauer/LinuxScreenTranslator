msgid "DeepL returned {status}."
msgstr "DeepL vrátil {status}."

#: linux_screen_translator/translate.py:150
msgid "DeepL returned {status}: {body}"
msgstr "DeepL vrátil {status}: {body}"

#: linux_screen_translator/translate.py:206
msgid "Could not reach DeepL: {error}"
msgstr "Nepodařilo se spojit s DeepL: {error}"

