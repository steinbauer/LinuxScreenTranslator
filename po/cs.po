msgid "No DeepL API key has been set."
msgstr "Není nastavený DeepL API klíč."

#: linux_screen_translator/translate.py:145
msgid "DeepL rejected the key (403). Check your API key."
msgstr "DeepL klíč odmítl (403). Zkontroluj API klíč."

