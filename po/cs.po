msgid "Choose…"
msgstr "Vybrat…"

#: linux_screen_translator/app.py:347
msgid "DeepL API key"
msgstr "DeepL API klíč"

#: linux_screen_translator/app.py:356
msgid "Check the key and refresh the quota"
msgstr "Ověřit klíč a načíst zbývající limit"

#: linux_screen_translator/app.py:361
msgid "Monthly quota"
msgstr "Měsíční limit"

#: linux_screen_translator/app.py:362
msgid "The key is kept in the system keyring, not in the config file."
msgstr "Klíč se ukládá do klíčenky systému, ne do konfiguračního souboru."

#: linux_screen_translator/app.py:425
msgid "Behaviour"
msgstr "Chování"

#: linux_screen_translator/app.py:428
msgid "Erase the original text"
msgstr "Vymazat původní text"

#: linux_screen_translator/app.py:429
msgid "Fills in the background underneath. When off, the translation is drawn over the original."
msgstr "Dopočítá pozadí pod textem. Vypnuté se překlad píše přes originál."

#: linux_screen_translator/app.py:437
msgid "Start with the session"
msgstr "Spouštět po přihlášení"

#: linux_screen_translator/app.py:438
#: linux_screen_translator/app.py:514
msgid "Puts the icon back in the top bar after logging in."
msgstr "Po přihlášení vrátí ikonu do horní lišty."

#: linux_screen_translator/app.py:445
msgid "Keep the captures"
msgstr "Ponechat pořízené snímky"

#: linux_screen_translator/app.py:446
msgid "The desktop saves every capture into your Screenshots folder."
msgstr "Prostředí ukládá každý záchyt do složky Snímky obrazovky."

#: linux_screen_translator/app.py:467
msgid "chosen by hand"
msgstr "vybráno ručně"

#: linux_screen_translator/app.py:467
msgid "picked for the target language"
msgstr "zvoleno podle cílového jazyka"

#: linux_screen_translator/app.py:483
msgid "Choose a typeface"
msgstr "Výběr písma"

#: linux_screen_translator/app.py:485
msgid "Fonts"
msgstr "Písma"

#: linux_screen_translator/app.py:532
#: linux_screen_translator/translate.py:196
msgid "Enter a key to see the remaining quota."
msgstr "Zadej klíč a uvidíš zbývající limit."

