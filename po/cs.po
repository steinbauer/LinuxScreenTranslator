msgid "DeepL rejected the key (403). Check that you copied all of it."
msgstr "DeepL klíč odmítl (403). Zkontroluj, že jsi ho zkopíroval celý."

#: linux_screen_translator/translate.py:214
msgid "{used} of {limit} characters used, {left} left ({tier} tier)"
msgstr "využito {used} z {limit} znaků, zbývá {left} ({tier} tarif)"

