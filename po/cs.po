msgid "Fills in the background underneath. When off, the translation is drawn over the original."
msgstr "Dopočítá pozadí pod textem. Vypnuté se překlad píše přes originál."

#: linux_screen_translator/app.py:368
msgid "Keep the captures"
msgstr "Ponechat pořízené snímky"

#: linux_screen_translator/app.py:369
msgid "The desktop saves every capture into your Screenshots folder."
msgstr "Prostředí ukládá každý záchyt do složky Snímky obrazovky."

#: linux_screen_translator/app.py:389
msgid "chosen by hand"
msgstr "vybráno ručně"

