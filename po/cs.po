msgid "Check the key and refresh the quota"
msgstr "Ověřit klíč a načíst zbývající limit"

#: linux_screen_translator/app.py:342
msgid "Monthly quota"
msgstr "Měsíční limit"

#: linux_screen_translator/app.py:343
msgid "The key is kept in the system keyring, not in the config file."
msgstr "Klíč se ukládá do klíčenky systému, ne do konfiguračního souboru."

#: linux_screen_translator/app.py:356
msgid "Behaviour"
msgstr "Chování"

#: linux_screen_translator/app.py:359
msgid "Erase the original text"
msgstr "Vymazat původní text"

