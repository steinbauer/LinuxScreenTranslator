msgid "Recognised text — {summary}"
msgstr "Rozpoznaný text — {summary}"

#: linux_screen_translator/app.py:278
#: linux_screen_translator/app.py:281
msgid "Saved to {path}"
msgstr "Uloženo do {path}"

#: linux_screen_translator/app.py:390
msgid "{pair} is ready."
msgstr "{pair} je připraven."

#: linux_screen_translator/app.py:394
msgid "{pair} is not installed — about 65 MB."
msgstr "{pair} není nainstalovaný — asi 65 MB."

#: linux_screen_translator/app.py:575
msgid "Settings — {name}"
msgstr "Nastavení — {name}"

#: linux_screen_translator/app.py:472
msgid "{font} has no glyphs for this language — the text would come out as empty boxes"
msgstr "{font} pro tento jazyk nemá znaky — text by vyšel jako prázdné rámečky"

#: linux_screen_translator/cli.py:12
msgid "image to process; without it the screen is captured"
msgstr "obrázek ke zpracování; bez něj se vyfotí obrazovka"

#: linux_screen_translator/cli.py:13
msgid "where to write the result"
msgstr "kam uložit výsledek"

#: linux_screen_translator/cli.py:14
msgid "target language, e.g. CS"
msgstr "cílový jazyk, například CS"

#: linux_screen_translator/cli.py:17
msgid "keep the original text instead of erasing it"
msgstr "nevymazávat původní text, jen přes něj psát"

#: linux_screen_translator/cli.py:50
msgid "→ (left unchanged)"
msgstr "→ (ponecháno beze změny)"

#: linux_screen_translator/cli.py:33
msgid "Selection cancelled."
msgstr "Výběr zrušen."

#: linux_screen_translator/cli.py:47
msgid "Done — {summary}, written to {path}"
msgstr "Hotovo — {summary}, uloženo do {path}"

#: linux_screen_translator/i18n.py:20
msgid "Linux Screen Translator"
msgstr "Překladač obrazovky pro Linux"

#: linux_screen_translator/offline.py:69
msgid "Looking for a model…"
msgstr "Hledám model…"

#: linux_screen_translator/offline.py:84
msgid "Downloading the model…"
msgstr "Stahuji model…"

#: linux_screen_translator/offline.py:82
msgid "The model entry carries no download link."
msgstr "Záznam modelu neobsahuje odkaz ke stažení."

#: linux_screen_translator/offline.py:106
msgid "Installing the model…"
msgstr "Instaluji model…"

#: linux_screen_translator/offline.py:104
msgid "The downloaded model looks empty."
msgstr "Stažený model je prázdný."

#: linux_screen_translator/offline.py:77
msgid "No offline model is published for {pair}."
msgstr "Pro {pair} není publikovaný žádný offline model."

#: linux_screen_translator/offline.py:138
msgid "Offline translation needs extra packages. Install them with: pip install ctranslate2 subword-nmt"
msgstr "Offline překlad potřebuje doplňkové balíky. Nainstaluj je příkazem: pip install ctranslate2 subword-nmt"

#: linux_screen_translator/offline.py:60
msgid "Could not fetch the model list: {error}"
msgstr "Nepodařilo se načíst seznam modelů: {error}"

#: linux_screen_translator/offline.py:144
msgid "No offline model for {pair} is installed yet."
msgstr "Model pro {pair} zatím není nainstalovaný."

#: linux_screen_translator/offline.py:98
msgid "Downloading the model failed: {error}"
msgstr "Stažení modelu selhalo: {error}"

#: linux_screen_translator/pipeline.py:31
msgid "Recognising text…"
msgstr "Rozpoznávám text…"

#: linux_screen_translator/pipeline.py:58
msgid "Rendering the translation…"
msgstr "Vykresluji překlad…"

#: linux_screen_translator/pipeline.py:22
msgid "{count} blocks in {seconds:.1f} s"
msgstr "{count} bloků za {seconds:.1f} s"

#: linux_screen_translator/pipeline.py:43
msgid "Translating {count} blocks…"
msgstr "Překládám {count} bloků…"

#: linux_screen_translator/translate.py:217
msgid "free"
msgstr "bezplatný"

#: linux_screen_translator/translate.py:217
msgid "paid"
msgstr "placený"

